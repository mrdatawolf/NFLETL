# Example config with placeholder/local paths — safe defaults for a fresh
# clone. None of these are secrets today, but if a source ever needs a real
# credential (API key, DB connection string, etc.), put it in .env only —
# never copy a live secret into this file.

# Bronze PostgreSQL connection. These are standard libpq variables, so the
# same values can also be used directly by psql. Keep real credentials in
# .env; do not commit them.
PGHOST=localhost
PGPORT=5432
PGDATABASE=bronze
PGUSER=nfletl
PGPASSWORD='replace-with-a-development-password'

# --- Tally pipeline ---
# Parses NBE Edger Optimizer Tally .txt reports into a standalone SQLite db,
# which is then landed into bronze like any other source (see TALLY below).
TALLY_SOURCE_DIR=./Examples/tally
TALLY_DB_PATH=./data/tally.db

# --- Sources ---
# Each source has a TYPE (sqlite | pglite) and a PATH.
# A source with an empty PATH is treated as "not configured" and skipped.
# For pglite sources point PATH at the PGlite data directory; for sqlite, at the .sqlite3 file.
# Always point at a clone/copy of the production database, never the live one.

RAPTOR_TYPE=sqlite
RAPTOR_PATH=

SAWFILERS_TYPE=sqlite
SAWFILERS_PATH=./Examples/SawFilers/app-db.sqlite3

# Porter is mocked until we get the real vendor database. Run `npm run seed:porter`
# to create and populate it, then it is ingested like any other source.
PORTER_TYPE=pglite
PORTER_PATH=./data/porter-mock
